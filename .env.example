APP_NAME=LaundryKu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laundryku
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# SECURITY (Tahap 19): cookie harus secure (HTTPS only) di production.
# Set true saat deploy ke HTTPS. Local dev http pakai false.
SESSION_SECURE_COOKIE=false
# SECURITY (Tahap 19): SameSite=Strict untuk anti-CSRF.
SESSION_SAME_SITE=strict
# SECURITY (Tahap 19): encrypt cookie payload.
SESSION_ENCRYPT=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# AI Configuration
AI_PROVIDER=openrouter
AI_MOCK_IN_LOCAL=true
OPENAI_API_KEY=sk-or-v1-5b2...40e
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemma-4-26b-a4b-it:free
AI_TIMEOUT=15
AI_RATE_LIMIT=10
AI_DAILY_LIMIT=150