APP_NAME=LaundryKu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laundryku
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# SECURITY (Tahap 19): cookie harus secure (HTTPS only) di production.
# Set true saat deploy ke HTTPS. Local dev http pakai false.
SESSION_SECURE_COOKIE=false
# SECURITY (Tahap 19): SameSite=Strict untuk anti-CSRF.
SESSION_SAME_SITE=strict
# SECURITY (Tahap 19): encrypt cookie payload.
SESSION_ENCRYPT=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# AI Configuration (OpenRouter)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
AI_MOCK_IN_LOCAL=false
AI_TIMEOUT=30
AI_RATE_LIMIT_PER_HOUR=30

# OTP & WhatsApp Gateway (Fonnte)
FONNTE_API_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com
FONNTE_WEBHOOK_TOKEN=
OTP_DEBUG_RESPONSE=false

# Mail (SMTP) Configuration
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@laundryku.test"
MAIL_FROM_NAME="${APP_NAME}"

# OpenStreetMap Nominatim Geocoding
NOMINATIM_USER_AGENT="LaundryKu/1.0 (contact@laundryku.test)"