APP_NAME=LaundryKu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laundryku
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email Configuration (SMTP Placeholder)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@laundryku.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateway (Xendit Dummy Placeholders)
XENDIT_SECRET_KEY=xnd_development_dummy_secret_key_placeholder
XENDIT_PUBLIC_KEY=xnd_public_development_dummy_public_key_placeholder
XENDIT_WEBHOOK_VERIFICATION_TOKEN=dummy_webhook_verification_token

# WhatsApp Gateway (Dummy Placeholders)
WHATSAPP_API_URL=https://api.whatsapp-gateway.example.com/v1
WHATSAPP_API_KEY=dummy_whatsapp_api_key_placeholder
WHATSAPP_SENDER_NUMBER=6281234567890

# AI Configuration
AI_PROVIDER=openai
AI_MOCK_IN_LOCAL=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=15
AI_RATE_LIMIT=10
AI_DAILY_LIMIT=100

# Super Admin Dev Credentials (Wajib diganti pada deployment produksi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@laundryku.id
ADMIN_NAME="Super Administrator"

VITE_APP_NAME="${APP_NAME}"

